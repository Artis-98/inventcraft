{
  "name": "a STEP bracket back into an editable tree: recognize, parametrize, edit a hole and the length; and a part it refuses",
  "calls": [
    {"tool": "new_document", "args": {"name": "Source bracket"}},
    {"tool": "build", "args": {"ops": [
      {"op": "parameter", "name": "w", "value": 110, "comment": "width"},
      {"op": "parameter", "name": "d", "value": 70, "comment": "plate depth"},
      {"op": "parameter", "name": "t", "value": 8, "comment": "thickness"},
      {"op": "parameter", "name": "h", "value": 30, "comment": "flange height"},
      {"op": "sketch", "id": "base", "plane": "XY", "name": "Plate outline", "entities": [
        {"rect": {"center": [0, 0], "size": ["w", "d"]}, "id": "r"}]},
      {"op": "extrude", "id": "plate", "sketch": "$base", "distance": "t", "name": "Plate"},
      {"op": "sketch", "id": "fl", "plane": "XY", "name": "Flange outline", "entities": [
        {"rect": {"corner": ["-w/2", "d/2 - t"], "size": ["w", "t"]}, "id": "f"}]},
      {"op": "extrude", "id": "flange", "sketch": "$fl", "distance": "h", "operation": "join", "name": "Flange"},
      {"op": "chamfer", "distance": 1.5, "edges": [{"near": [0, 35, 30], "count": 1}], "name": "Flange edge"},
      {"op": "fillet", "radius": 6, "edges": [{"near": [-55, -35, 4], "count": 1}, {"near": [55, -35, 4], "count": 1}], "name": "Front corners"},
      {"op": "sketch", "id": "hs", "plane": "XY", "name": "Bolt centre", "entities": [
        {"point": ["-w/3", "-d/6"], "id": "p"}]},
      {"op": "hole", "id": "bolt", "sketch": "$hs", "diameter": 9, "points": ["p"], "through": true, "name": "Bolt hole"},
      {"op": "pattern", "parents": ["$bolt"], "count1": 3, "spacing1": "w/3", "dir1": "X", "name": "Bolt row"}]}},
    {"tool": "inspect", "args": {"expected": {"bbox": [110, 70, 30], "volume": 79185.825, "faces": 14, "solids": 1, "valid": true, "tolerance": 0.001}},
     "expect": {"verdict": true}},
    {"tool": "export", "args": {"path": "{TMP}/bracket.step"}},
    {"tool": "close_document", "args": {}},

    {"tool": "new_document", "args": {"name": "Imported bracket"}},
    {"tool": "build", "args": {"ops": [{"op": "import", "path": "{TMP}/bracket.step"}]}},
    {"tool": "inspect", "args": {"expected": {"bbox": [110, 70, 30], "volume": 79185.825, "faces": 14, "solids": 1, "valid": true, "tolerance": 0.001}},
     "expect": {"verdict": true}},
    {"tool": "model_tree", "args": {}, "expect": {"contains": "Imported Body"}},

    {"tool": "recognize", "args": {}, "expect": {"contains": "3 holes, 1 chamfer, 1 fillet", "fields": {"prismatic": true, "axis": "x"}}},
    {"tool": "recognize", "args": {"detail": true}, "expect": {"contains": "\"op\": \"hole\""}},
    {"tool": "parametrize", "args": {"dry_run": true}, "expect": {"contains": "parametrize dry run ok"}},
    {"tool": "model_tree", "args": {}, "expect": {"contains": "Imported Body"}},
    {"tool": "parametrize", "args": {}, "expect": {"contains": "parametrize ok"}},
    {"tool": "inspect", "args": {"expected": {"bbox": [110, 70, 30], "volume": 79185.825, "faces": 14, "solids": 1, "valid": true, "tolerance": 0.001}},
     "expect": {"verdict": true}},
    {"tool": "model_tree", "args": {}, "expect": {"contains": "Base profile"}},
    {"tool": "read_ir", "args": {}, "expect": {"contains": "\"name\": \"hole_d\""}},

    {"tool": "properties", "args": {"parameters": {"hole_d": 12}}},
    {"tool": "inspect", "args": {"expected": {"bbox": [110, 70, 30], "volume": 77998.303, "solids": 1, "valid": true, "tolerance": 0.001}},
     "expect": {"verdict": true}},
    {"tool": "properties", "args": {"parameters": {"hole_d": 9, "length": 150}}},
    {"tool": "inspect", "args": {"expected": {"bbox": [150, 70, 30], "solids": 1, "valid": true}},
     "expect": {"verdict": true}},
    {"tool": "properties", "args": {"parameters": {"length": 110, "z_step1": 10}}},
    {"tool": "inspect", "args": {"expected": {"bbox": [110, 70, 32], "solids": 1, "valid": true}},
     "expect": {"verdict": true}},
    {"tool": "properties", "args": {"parameters": {"z_step1": 8}}},
    {"tool": "inspect", "args": {"expected": {"bbox": [110, 70, 30], "volume": 79185.825, "faces": 14, "solids": 1, "valid": true, "tolerance": 0.001}},
     "expect": {"verdict": true}},
    {"tool": "render_view", "args": {"view": "iso", "width": 400, "height": 300}, "expect": {"image": true}},
    {"tool": "close_document", "args": {}},

    {"tool": "new_document", "args": {"name": "Partial source"}},
    {"tool": "build", "args": {"ops": [
      {"op": "sketch", "id": "s1", "plane": "XY", "entities": [{"rect": {"center": [0, 0], "size": [100, 60]}}]},
      {"op": "extrude", "id": "e1", "sketch": "$s1", "distance": 8, "name": "Plate"},
      {"op": "sketch", "id": "hs", "plane": "XY", "entities": [{"point": [-30, 0], "id": "p"}]},
      {"op": "hole", "sketch": "$hs", "diameter": 8, "points": ["p"], "through": true},
      {"op": "workplane", "id": "top", "base": "XY", "offset": 8},
      {"op": "sketch", "id": "bs", "plane": "$top", "entities": [{"rect": {"center": [25, 0], "size": [24, 24]}}]},
      {"op": "extrude", "id": "boss", "sketch": "$bs", "distance": 14, "operation": "join", "taper": 10, "name": "Tapered boss"}]}},
    {"tool": "export", "args": {"path": "{TMP}/tapered.step"}},
    {"tool": "close_document", "args": {}},

    {"tool": "new_document", "args": {"name": "Imported tapered"}},
    {"tool": "build", "args": {"ops": [{"op": "import", "path": "{TMP}/tapered.step"}]}},
    {"tool": "recognize", "args": {}, "expect": {"contains": "unexplained"}},
    {"tool": "parametrize", "args": {}, "expect": {"error": true, "contains": "PARTIAL_COVERAGE"}},
    {"tool": "model_tree", "args": {}, "expect": {"contains": "Imported Body"}},
    {"tool": "inspect", "args": {"expected": {"volume": 56519.688, "solids": 1, "valid": true, "tolerance": 0.001}},
     "expect": {"verdict": true}}
  ]
}
